# ============================================================
# Backend — Environment Variables
# Copy this file to backend/.env and fill in your values.
# ============================================================

# ----- Server -----
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173

# ----- MongoDB -----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=ai_bg_remover

# ----- Auth -----
SECRET_KEY=generate-with-python-secrets-token-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie security — set COOKIE_SECURE=true and COOKIE_SAMESITE=none in production (HTTPS)
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ----- Social sign-in (optional — leave blank to hide the buttons) -----
# Google: https://console.cloud.google.com/apis/credentials  (OAuth client ID, Web application)
#   Authorized redirect URI: <BACKEND_PUBLIC_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers  (OAuth Apps -> New)
#   Authorization callback URL: <BACKEND_PUBLIC_URL>/api/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public URL of THIS backend (used to build the redirect URI). Dev default shown.
BACKEND_PUBLIC_URL=http://localhost:8000
# Where to send the user after sign-in. Defaults to the first ALLOWED_ORIGINS entry.
# FRONTEND_URL=http://localhost:5173

# ----- File Cleanup -----
# How long processed files are kept before automatic deletion (in hours).
FILE_MAX_AGE_HOURS=24
# How often the cleanup sweep runs (in minutes).
CLEANUP_INTERVAL_MINS=60

# ----- AI Provider -----
# Supported providers: gemini (default), groq
AI_PROVIDER=gemini

# ----- Gemini (Google) -----
# Required when AI_PROVIDER=gemini (or for AI Assistant / Chatbot / Vision features)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
# Optional — override the default model tiers (defaults to gemini-3.6-flash)
# GEMINI_CHAT_MODEL=gemini-2.0-flash
# GEMINI_VISION_MODEL=gemini-2.0-flash

# ----- Groq -----
# Required when AI_PROVIDER=groq
# Get your key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional — override the default model tiers
# GROQ_CHAT_MODEL=llama-3.3-70b-versatile
# GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ----- Storage -----
# STORAGE_BACKEND=local          (default — saves to ./output/)
# STORAGE_BACKEND=s3             (AWS S3 or any S3-compatible API, e.g. Cloudflare R2)

# Required when STORAGE_BACKEND=s3:
# S3_BUCKET=your-bucket-name
# S3_REGION=us-east-1
# S3_ACCESS_KEY=AKIAxxxxxxxxxxxxxxxx
# S3_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# S3_ENDPOINT_URL=                # Leave blank for AWS. Set for R2/MinIO/etc.
#   Cloudflare R2 example: https://<account-id>.r2.cloudflarestorage.com
# S3_PUBLIC_URL=                  # Optional CDN prefix for public URLs
